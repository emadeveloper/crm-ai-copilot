# ---------------------------------------------------------------------------
# Copy to services/api/.env for local backend development:
#   cp env.example services/api/.env
# ---------------------------------------------------------------------------

# Async SQLAlchemy URL. Local Postgres or a Neon connection string.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crm_ai_copilot

# Google AI Studio key (free tier, no card). https://aistudio.google.com/apikey
GEMINI_API_KEY=your-ai-studio-key
# Flash-class only on the free tier (Pro is paid since Apr 2026).
LLM_MODEL=gemini-3.6-flash
# Free-tier budget is ~15 requests/minute. The adapter throttles to this.
LLM_RATE_PER_MIN=15

# HubSpot Private App token (free CRM plan). Settings > Integrations > Private Apps.
HUBSPOT_PRIVATE_APP_TOKEN=your-hubspot-private-app-token

# Browser origins allowed to call the API (comma-separated). Add the Vercel URL in prod.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# Pipeline worker
MAX_TASK_ATTEMPTS=5
WORKER_POLL_INTERVAL_SECONDS=2

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Frontend (apps/web) — copy to apps/web/.env.local
# ---------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
